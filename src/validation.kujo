from src.common import get, has, safe_id, valid_timestamp, find_sensitive_key, parse_object
from src.domain import record_type, id_prefix, validate_command
from src.authentication import verify_record_authentication
from src.filesystem import confined_digest, confined_read
from src.profile import profile
from src.storage import list_records, inspect_transactions
from src.audit import reconcile_record, list_history

export func validate_record(record, p, verification_key, artifact_root) {
    for key in ["schema_version", "tool_version", "contract_version", "id", "record_type", "command", "actor", "created_at", "provenance", "payload"] {
        if has_key(record, key) == 0 { return {"ok": false, "code": "missing_field", "error": "record missing field: " + key} }
    }
    supported_versions := get(p, "record_versions", [p["version"]])
    if record["schema_version"] != "1.0.0" || record["contract_version"] != p["contract_version"] || !has(supported_versions, record["tool_version"]) { return {"ok": false, "code": "incompatible_record", "error": "record tool or contract version is incompatible"} }
    if !has(p["mutation_commands"], record["command"]) || record["record_type"] != record_type(record["command"]) { return {"ok": false, "code": "invalid_record", "error": "record command or type is invalid"} }
    if !safe_id(record["id"]) || !valid_timestamp(record["created_at"]) || type(record["actor"]) != "string" || trim(record["actor"]) == "" || len(record["actor"]) > 256 || !regex_match(record["actor"], "^[^\\x00-\\x1F\\x7F]+$") { return {"ok": false, "code": "invalid_record", "error": "record id, actor, or timestamp is invalid"} }
    if type(record["payload"]) != "dict" || type(record["provenance"]) != "array" { return {"ok": false, "code": "invalid_record", "error": "payload/provenance shape is invalid"} }
    if !starts_with(record["id"], id_prefix(record["command"]) + "-") { return {"ok": false, "code": "invalid_record", "error": "record id does not match its command"} }
    payload_schema := get(record["payload"], "schema_version", "1.0.0")
    if type(payload_schema) != "string" || !regex_match(payload_schema, "^1\\.[0-9]+\\.[0-9]+$") || find_sensitive_key(record["payload"], "") != "" { return {"ok": false, "code": "invalid_record", "error": "payload schema or secret-field policy is invalid"} }
    authentication := verify_record_authentication(record, verification_key); if !authentication["ok"] { return authentication }
    receipt := get(record, "execution_receipt", null)
    if has_key(record,"execution_receipt") == 1 {
        if type(receipt) != "dict" || !has(["planned", "completed"], get(receipt, "execution", "")) || !has(["render", "convert", "resize", "thumbnail", "captions", "transcript"], record["command"]) { return {"ok": false, "code": "invalid_record", "error": "invalid execution receipt"} }
        if has_key(receipt,"provider_class") == 1 && !has(["ffmpeg","kujo-captions"],receipt["provider_class"]) { return {"ok":false,"code":"invalid_record","error":"unsupported receipt provider"} }
        if has_key(receipt,"source_sha256") == 1 && (type(receipt["source_sha256"]) != "string" || !regex_match(receipt["source_sha256"],"^[a-f0-9]{64}$")) { return {"ok":false,"code":"invalid_record","error":"invalid receipt source digest"} }
        if receipt["execution"] == "completed" && (!has(["ffmpeg","kujo-captions"],get(receipt, "provider_class", "")) || type(get(receipt, "source_sha256", null)) != "string" || !regex_match(get(receipt, "source_sha256", ""), "^[a-f0-9]{64}$") || type(get(record, "artifact", null)) != "dict") { return {"ok": false, "code": "invalid_record", "error": "completed transform requires source digest and generated artifact"} }
    }
    if type(receipt)=="dict" && get(receipt,"provider_class","")=="ffmpeg" && has(["captions","transcript"],record["command"]) { return {"ok":false,"code":"invalid_record","error":"FFmpeg receipt cannot describe caption processing"} }
    if type(receipt)=="dict" && get(receipt,"provider_class","")=="kujo-captions" {
        if !has(["captions","transcript"],record["command"]) || !has(["srt","vtt"],get(receipt,"input_format","")) || !has(["srt","vtt","text"],get(receipt,"output_format","")) || type(get(receipt,"cues",null))!="int" || receipt["cues"]<1 || receipt["cues"]>10000 || get(receipt,"output_format","")!=get(record["payload"],"format","") || get(receipt,"input_format","")!=get(record["payload"],"input_format","") || has_key(receipt,"isolation")==1 { return {"ok":false,"code":"invalid_record","error":"invalid caption adapter receipt"} }
    }
    if type(receipt)=="dict" && has_key(receipt,"isolation")==1 {
        if !has(["local","container"],receipt["isolation"]) { return {"ok":false,"code":"invalid_record","error":"unknown execution isolation"} }
        if receipt["isolation"]=="container" && (type(get(receipt,"image",null))!="string" || !regex_match(get(receipt,"image",""),"^sha256:[a-f0-9]{64}$") || get(receipt,"network","")!="none" || get(receipt,"memory_bytes",0)!=268435456 || get(receipt,"pids_limit",0)!=64) { return {"ok":false,"code":"invalid_record","error":"invalid container execution boundary receipt"} }
    }
    artifact := get(record, "artifact", null)
    if has_key(record,"artifact") == 1 && type(artifact) != "dict" { return {"ok": false, "code": "invalid_record", "error": "artifact must be an object"} }
    if type(artifact) == "dict" {
        path := get(artifact, "path", "")
        if type(path) != "string" || type(get(artifact, "bytes", null)) != "int" || type(get(artifact, "sha256", null)) != "string" { return {"ok": false, "code": "invalid_record", "error": "artifact fields have invalid types"} }
        if artifact_root != "" { path = artifact_root + "/" + get(artifact,"sha256","") + ".blob" }
        maximum := get(artifact, "maximum_bytes", 67108864)
        if type(maximum) != "int" || maximum < 1 || maximum > 4294967296 || artifact["bytes"] < 0 || artifact["bytes"] > maximum || !regex_match(artifact["sha256"], "^[a-f0-9]{64}$") { return {"ok": false, "code": "invalid_record", "error": "artifact bounds or digest are invalid"} }
        mut observed := null
        try { observed = confined_digest(path, maximum) }
        except error {
            if contains(to_string(error),"size_limit_exceeded") == 1 { return {"ok":false,"code":"artifact_size_drift","error":"bound artifact exceeds its recorded limit"} }
            return {"ok": false, "code": "artifact_missing", "error": "bound artifact is unsafe or missing"}
        }
        if observed["bytes"] != artifact["bytes"] { return {"ok": false, "code": "artifact_size_drift", "error": "bound artifact size has drifted"} }
        if observed["sha256"] != artifact["sha256"] { return {"ok": false, "code": "checksum_drift", "error": "bound artifact checksum drift detected"} }
    }
    error := validate_command(record["command"], record["payload"], get(record, "artifact", null))
    if error != "" { return {"ok": false, "code": "domain_validation", "error": error} }
    return {"ok": true}
}

export func verify_complete_state(state, artifact_root, verification_key) {
    p := profile()
    mut metadata := null
    try { metadata = parse_object(confined_read(state+"/metadata.json",65536),"state metadata") }
    except error { return {"ok":false,"error":"state metadata is missing or unsafe"} }
    if !metadata["ok"] || get(get(metadata,"value",{}),"tool","")!=p["slug"] || get(get(metadata,"value",{}),"contract_version","")!=p["contract_version"] { return {"ok":false,"error":"incompatible state metadata"} }
    mut after := ""; mut done := false
    while !done {
        listing := list_records(state,"",after,1000)
        if len(listing["warnings"])>0 { return {"ok":false,"error":"record storage warnings"} }
        for record in listing["records"] {
            checked := validate_record(record,p,verification_key,artifact_root)
            if checked["ok"] { checked = reconcile_record(state,record,listing["checksums"][record["id"]]) }
            if !checked["ok"] { return checked }
        }
        done = !listing["truncated"]
        if !done && listing["next_after"]==after { return {"ok":false,"error":"record cursor did not advance"} }
        after = listing["next_after"]
    }
    for kind in ["history","transactions"] {
        after = ""; done = false
        while !done {
            mut page := null
            if kind=="history" { page = list_history(state,after,1000,true) } else { page = inspect_transactions(state,after,1000) }
            if len(page["warnings"])>0 { return {"ok":false,"error":kind+" reconciliation failed"} }
            done = !page["truncated"]
            if !done && page["next_after"]==after { return {"ok":false,"error":"audit cursor did not advance"} }
            after = page["next_after"]
        }
    }
    return {"ok":true}
}

