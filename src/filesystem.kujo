// Anchor effects at the filesystem root and traverse every remaining component
// with Kujo's descriptor-relative no-follow primitives.
export func confined_path(path) {
    if type(path) != "string" || trim(path) == "" || regex_match(path, "[\\x00]") { throw("invalid filesystem path") }
    normalized := replace_str(path, "\\", "/")
    if starts_with(normalized, "//?/") { normalized = substring(normalized, 4, len(normalized)) }
    if starts_with(normalized, "//") { throw("UNC paths are not supported; use a local volume") }
    if !starts_with(normalized, "/") && !regex_match(normalized, "^[A-Za-z]:/") { normalized = replace_str(path_absolute("."), "\\", "/") + "/" + normalized }
    if starts_with(normalized, "//?/") { normalized = substring(normalized, 4, len(normalized)) }
    anchor := "/"
    if regex_match(normalized, "^[A-Za-z]:/") { anchor = substring(normalized, 0, 3); normalized = substring(normalized, 3, len(normalized)) }
    mut components := []
    for part in split(normalized, "/") {
        if part == ".." || contains(part, ":") == 1 { throw("unsafe filesystem component") }
        if part != "" && part != "." { components = push(components, part) }
    }
    if len(components) == 0 { throw("path must name a file") }
    return {"root": anchor, "relative": join(components, "/")}
}

export func confined_read(path, maximum) {
    target := confined_path(path)
    return read_file_beneath(target["root"], target["relative"], maximum)
}

export func confined_write(path, content, overwrite) {
    target := confined_path(path)
    return write_file_atomic_beneath(target["root"], target["relative"], content, overwrite)
}

export func is_link(path) { try { return path_is_symlink(path) } except error { return false } }

export func ensure_managed_dir(path) {
    marker := path + "/.assetworks-directory"
    try { confined_write(marker, "AssetWorks managed directory\n", false) }
    except error {
        try { if confined_read(marker, 128) == "AssetWorks managed directory\n" { return "" } } except read_error {}
        return "cannot safely initialize managed directory: " + path
    }
    return ""
}

export func confined_digest(path, maximum) {
    target := confined_path(path)
    return sha256_file_beneath(target["root"], target["relative"], maximum)
}

// Opaque filename cursors also advance past malformed JSON names.
export func safe_page_cursor(cursor) {
    if type(cursor) != "string" || len(cursor) > 1024 { return false }
    if cursor == "" { return true }
    if starts_with(cursor,"file:") { return !regex_match(substring(cursor,5,len(cursor)), "[/\\\\\\x00]") && len(cursor)>5 }
    return regex_match(cursor,"^[a-z0-9][a-z0-9-]{1,127}$")
}
export func directory_page(directory, after, limit) {
    if !safe_page_cursor(after) { return {"ok":false,"error":"invalid page cursor"} }
    target := confined_path(directory)
    // Missing state is empty only when no existing ancestor is a symlink.
    current := target["root"]
    for component in split(target["relative"],"/") {
        if !ends_with(current,"/") { current = current + "/" }
        current = current + component
        if is_link(current) { return {"ok":false,"error":"directory path has a symlink component"} }
    }
    if !file_exists(directory) { return {"ok":true,"names":[],"truncated":false,"scanned":0} }
    cursor := after
    if starts_with(cursor,"file:") { cursor = substring(cursor,5,len(cursor)) }
    if starts_with(after,"file:") && ends_with(cursor,".json") { cursor = substring(cursor,0,len(cursor)-5) }
    // The native iterator orders suffix-stripped IDs. Preserve its ordering for
    // prefix IDs while allowing a cursor to advance beyond malformed .json.
    skip_empty := after == "file:.json"
    requested := limit
    if skip_empty && requested < 1000 { requested = requested + 1 }
    try {
        page := list_dir_beneath(target["root"],target["relative"],cursor,".json",requested,100000)
        if skip_empty {
            names := []
            for name in page["names"] { if name != ".json" { names = push(names,name) } }
            page["names"] = names
        }
        page["ok"] = true
        return page
    } except error { return {"ok":false,"error":"directory is unsafe, unreadable or exceeds 100000 entries"} }
}
