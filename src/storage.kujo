from src.filesystem import confined_read, confined_write, is_link, ensure_managed_dir, directory_page, collection_path, page_cursor
from src.common import get, parse_object, safe_id, canonical_json, valid_timestamp

// Inspect existing explicitly named components before reading or creating state.
export func validate_path_components(path) {
    if type(path) != "string" || trim(path) == "" { return "path is empty or invalid" }
    normalized := replace_str(path, "\\", "/")
    mut current := ""; if starts_with(normalized, "/") { current = "/" }
    for part in split(normalized, "/") {
        if part == ".." { return "path traversal is not allowed" }
        if part != "" && part != "." {
            if current == "/" { current = "/" + part } else if current == "" { current = part } else { current = current + "/" + part }
            if is_link(current) { return "symlink path components are not allowed: " + current }
        }
    }
    return ""
}

export func validate_state_path(path) {
    if file_exists(path+"/.migration-in-progress") || is_link(path+"/.migration-in-progress") { return "migration is incomplete; destination cannot be used as state" }
    error := validate_path_components(path); if error != "" { return error }
    if file_exists(path) && !path_is_dir(path) { return "state path is not a directory" }
    return ""
}

export func records_dir(state) { return join_path(state, "records") }
export func history_dir(state) { return join_path(state, "history") }
func locks_dir(state) { return join_path(state, "locks") }
export func record_path(state, id) { return collection_path(records_dir(state), id + ".json") }

export func initialize(state, metadata) {
    error := validate_state_path(state); if error != "" { return {"ok": false, "code": "unsafe_state", "error": error} }
    for dir in [records_dir(state), history_dir(state), locks_dir(state)] { error = validate_state_path(dir); if error != "" { return {"ok": false, "code": "unsafe_state", "error": error} }; error = ensure_managed_dir(dir); if error != "" { return {"ok": false, "code": "unsafe_state", "error": error} }; if path_is_symlink(dir) || !path_is_dir(dir) { return {"ok": false, "code": "unsafe_state", "error": "managed state paths must be regular directories"} } }
    path := join_path(state, "metadata.json")
    if file_exists(path) {
        if path_is_symlink(path) || !path_is_file(path) { return {"ok": false, "code": "unsafe_state", "error": "metadata must be a regular non-symlink file"} }
        if file_size(path) > 65536 { return {"ok": false, "code": "metadata_too_large", "error": "metadata exceeds 64 KiB"} }
        parsed := parse_object(confined_read(path, 65536), "state metadata"); if !parsed["ok"] { return parsed }
        existing := parsed["value"]
        if get(existing, "tool", "") != get(metadata, "tool", "") || get(existing, "contract_version", "") != get(metadata, "contract_version", "") { return {"ok": false, "code": "incompatible_state", "error": "state metadata belongs to an incompatible tool or contract"} }
    } else {
        try { confined_write(path, to_json_pretty(metadata) + "\n", false) }
        except error {
            parsed := parse_object(confined_read(path, 65536), "state metadata")
            if !parsed["ok"] { return parsed }
            if get(parsed["value"], "tool", "") != get(metadata, "tool", "") || get(parsed["value"], "contract_version", "") != get(metadata, "contract_version", "") { return {"ok": false, "code": "incompatible_state", "error": "concurrent initialization created incompatible metadata"} }
        }
    }
    return {"ok": true, "value": {"state": state, "initialized": true}}
}

export func initialize_layout(state, metadata, layout) {
    if layout == "flat" { return initialize(state, metadata) }
    if layout != "sharded-v1" { return storage_error("invalid_layout", "layout must be flat or sharded-v1") }
    if file_exists(state) || is_link(state) { return storage_error("layout_exists", "sharded initialization requires a new state directory; use migrate for existing state") }
    try {
        for name in ["records","history","transactions"] { confined_write(state+"/"+name+"/.assetworks-shards", "sha256-256-v1\n", false) }
        return initialize(state,metadata)
    } except error { return storage_error("layout_failed", "layout initialization failed; inspect the new directory before retrying") }
}

func storage_error(code, message) { return {"ok": false, "code": code, "error": message} }
func journal_path(state, id) { return collection_path(state + "/transactions", id + ".json") }

func event_text(record, record_checksum) {
    return to_json_pretty({"schema_version": "1.0.0", "event": "record.created", "record_id": record["id"], "actor": record["actor"], "at": record["created_at"], "record_sha256": record_checksum}) + "\n"
}

func publish_exact(path, text) {
    try { confined_write(path, text, false) }
    except error {
        try { if confined_read(path, 1048576) == text { return {"ok": true} } } except read_error {}
        return storage_error("recovery_conflict", "existing file differs from the immutable transaction: " + path)
    }
    return {"ok": true}
}

func noop_checkpoint(phase) {}

export func save_new(state, record) { return save_with_checkpoints(state, record, noop_checkpoint) }

// Testable write boundaries use the same implementation as ordinary writes.
// The CLI supplies no callback or environment-triggered fault injection.
export func save_with_checkpoints(state, record, checkpoint) {
    for dir in [state, records_dir(state), history_dir(state), locks_dir(state)] {
        problem := validate_state_path(dir)
        if problem != "" || !path_is_dir(dir) { return storage_error("unsafe_state", "storage directories must exist and be safe") }
    }
    id := get(record, "id", "")
    if !safe_id(id) || !valid_timestamp(get(record, "created_at", "")) || type(get(record, "actor", null)) != "string" { return storage_error("unsafe_id", "invalid record identity") }
    if path_is_dir(locks_dir(state) + "/" + id + ".lock") { return storage_error("write_conflict", "legacy lock present; stop legacy writers before removing the lock") }
    path := record_path(state, id)
    if file_exists(path) || is_link(path) { return storage_error("duplicate_id", "record already exists: " + id) }
    serialized := to_json_pretty(record) + "\n"
    if byte_length(serialized) > 1048576 { return storage_error("record_too_large", "serialized record exceeds 1 MiB") }
    record_checksum := sha256(serialized)
    event_name := substring(sha256(record["created_at"] + "\n" + id), 0, 32) + ".json"
    event_path := collection_path(history_dir(state), event_name)
    if file_exists(event_path) || is_link(event_path) { return storage_error("history_conflict", "audit history event already exists") }
    audit_text := event_text(record, record_checksum)
    journal := {"schema_version": "1.0.0", "record_id": id, "record_text": serialized, "record_sha256": record_checksum, "event_name": event_name, "event_text": audit_text}
    // Atomic no-replace publication elects one writer for an ID, without stale locks.
    try { confined_write(journal_path(state, id), to_json(journal) + "\n", false) }
    except error { return storage_error("recovery_required", "transaction already exists or could not be created; inspect and recover --id " + id) }
    checkpoint("journal")
    published := publish_exact(path, serialized); if !published["ok"] { return published }
    checkpoint("record")
    published = publish_exact(event_path, audit_text); if !published["ok"] { return published }
    checkpoint("event")
    return {"ok": true, "value": {"path": path, "checksum": record_checksum}}
}

func load_transaction(state, id) {
    if !safe_id(id) { return storage_error("unsafe_id", "recovery requires a safe record id") }
    problem := validate_state_path(state); if problem != "" { return storage_error("unsafe_state", problem) }
    mut contents := ""
    try { contents = confined_read(journal_path(state, id), 4194304) }
    except error { return storage_error("journal_missing", "transaction journal is missing, unsafe or oversized") }
    parsed := parse_object(contents, "transaction journal"); if !parsed["ok"] { return parsed }
    journal := parsed["value"]
    if get(journal, "schema_version", "") != "1.0.0" || get(journal, "record_id", "") != id || type(get(journal, "record_text", null)) != "string" || type(get(journal, "event_text", null)) != "string" { return storage_error("invalid_journal", "invalid transaction schema") }
    serialized := journal["record_text"]
    if byte_length(serialized) > 1048576 || sha256(serialized) != get(journal, "record_sha256", "") { return storage_error("invalid_journal", "transaction record checksum does not match") }
    parsed_record := parse_object(serialized, "transaction record"); if !parsed_record["ok"] { return parsed_record }
    record := parsed_record["value"]
    if get(record, "id", "") != id || !valid_timestamp(get(record, "created_at", "")) || type(get(record, "actor", null)) != "string" { return storage_error("invalid_journal", "transaction identity does not match") }
    expected_name := substring(sha256(record["created_at"] + "\n" + id), 0, 32) + ".json"
    expected_event := event_text(record, journal["record_sha256"])
    if get(journal, "event_name", "") != expected_name || journal["event_text"] != expected_event { return storage_error("invalid_journal", "transaction audit event does not match") }
    return {"ok": true, "read_bytes": byte_length(contents), "value": {"record_text": serialized, "event_text": expected_event, "event_name": expected_name, "checksum": journal["record_sha256"]}}
}

export func recover_record(state, id) {
    transaction := load_transaction(state, id); if !transaction["ok"] { return transaction }
    data := transaction["value"]
    serialized := data["record_text"]; expected_event := data["event_text"]; expected_name := data["event_name"]
    // Preflight both files before filling either gap. Never delete or replace data.
    for entry in [{"path": record_path(state, id), "text": serialized}, {"path": collection_path(history_dir(state), expected_name), "text": expected_event}] {
        if file_exists(entry["path"]) || is_link(entry["path"]) {
            try { if confined_read(entry["path"], 1048576) != entry["text"] { return storage_error("recovery_conflict", "existing transaction data differs") } }
            except error { return storage_error("recovery_conflict", "existing transaction data is unsafe") }
        }
    }
    published := publish_exact(record_path(state, id), serialized); if !published["ok"] { return published }
    published = publish_exact(collection_path(history_dir(state), expected_name), expected_event); if !published["ok"] { return published }
    return {"ok": true, "value": {"id": id, "recovered": true, "checksum": data["checksum"]}}
}

export func inspect_transactions(state, after, limit) {
    mut entries := []; mut warnings := []; mut next_after := after; mut read_bytes := 0
    page := directory_page(state + "/transactions",after,limit)
    if !page["ok"] { return {"entries":[],"warnings":[{"id":"","code":"unsafe_state","error":page["error"]}],"truncated":true,"next_after":after} }
    truncated := page["truncated"]
    for name in page["names"] {
        if read_bytes + 6291456 > 33554432 { truncated = true; break }
        next_after = page_cursor(page,name)
        if ends_with(name,".json") {
            id := substring(name,0,len(name)-5)
            transaction := load_transaction(state,id)
            // Failed journal reads may have consumed their entire allowance.
            read_bytes = read_bytes + get(transaction,"read_bytes",4194304)
            if transaction["ok"] {
                data := transaction["value"]
                for item in [{"path":record_path(state,id),"text":data["record_text"]},{"path":collection_path(history_dir(state),data["event_name"]),"text":data["event_text"]}] {
                    try {
                        actual := confined_read(item["path"],1048576); read_bytes = read_bytes + byte_length(actual)
                        if actual != item["text"] { transaction = storage_error("transaction_drift","stored bytes differ from their transaction") }
                    } except error { read_bytes = read_bytes + 1048576; transaction = storage_error("recovery_required","transaction is incomplete or unsafe; recover --id " + id) }
                }
            }
            entries = push(entries,{"id":id,"complete":transaction["ok"]})
            if !transaction["ok"] { warnings = push(warnings,{"id":id,"code":transaction["code"],"error":transaction["error"]}) }
        }
    }
    return {"entries":entries,"warnings":warnings,"truncated":truncated,"next_after":next_after,"read_bytes":read_bytes}
}

export func load_record(state, id) {
    if !safe_id(id) { return {"ok": false, "code": "unsafe_id", "error": "unsafe record id"} }
    state_error := validate_state_path(state); if state_error != "" { return {"ok": false, "code": "unsafe_state", "error": state_error} }
    dir := records_dir(state); if file_exists(dir) && (path_is_symlink(dir) || !path_is_dir(dir)) { return {"ok": false, "code": "unsafe_state", "error": "records path must be a regular directory"} }
    return read_record_file(state, id)
}

// Listing validates its shared directory once; retain per-file checks for every read.
func read_record_file(state, id) {
    if !safe_id(id) { return {"ok": false, "code": "unsafe_id", "error": "unsafe record id"} }
    path := record_path(state, id)
    if !path_is_file(path) || path_is_symlink(path) { return {"ok": false, "code": "not_found", "error": "record not found: " + id} }
    if file_size(path) > 1048576 { return {"ok": false, "code": "record_too_large", "error": "record exceeds 1 MiB"} }
    mut contents := ""
    try { contents = confined_read(path, 1048576) } except error { return storage_error("unsafe_record", "record read failed or exceeded its byte limit") }
    parsed := parse_object(contents, "record " + id); if !parsed["ok"] { parsed["read_bytes"] = byte_length(contents); return parsed }
    if get(parsed["value"], "id", "") != id { return {"ok": false, "code": "id_mismatch", "error": "record id does not match filename"} }
    return {"ok": true, "value": parsed["value"], "checksum": sha256(contents), "read_bytes": byte_length(contents)}
}

export func list_records(state, kind, after, limit) {
    mut records := []; mut warnings := []; mut checksums := {}; mut next_after := after; mut read_bytes := 0
    page := directory_page(records_dir(state), after, limit)
    if !page["ok"] { return {"records":[],"checksums":{},"warnings":[{"id":"","code":"unsafe_state","error":page["error"]}],"truncated":true,"next_after":after,"read_bytes":0} }
    truncated := page["truncated"]
    for name in page["names"] {
        // Reserve the per-file maximum before reading; never exceed 8 MiB per page.
        if read_bytes + 1048576 > 8388608 { truncated = true; break }
        next_after = page_cursor(page,name)
        if ends_with(name,".json") {
            id := substring(name,0,len(name)-5)
            loaded := read_record_file(state,id)
            read_bytes = read_bytes + get(loaded,"read_bytes",1048576)
            if loaded["ok"] {
                record := loaded["value"]
                if kind == "" || get(record,"record_type","") == kind { records = push(records,record); checksums[id] = loaded["checksum"] }
            } else { warnings = push(warnings,{"id":id,"code":loaded["code"],"error":loaded["error"]}) }
        }
    }
    return {"records":records,"warnings":warnings,"checksums":checksums,"truncated":truncated,"next_after":next_after,"read_bytes":read_bytes,"directory_entries_scanned":page["scanned"]}
}

// Resolve existing ancestors so absent output files receive the same protection.
export func canonical_destination(path) {
    normalized := replace_str(path, "\\", "/")
    if file_exists(normalized) { return replace_str(path_absolute(normalized), "\\", "/") }
    mut parts := split(normalized, "/"); mut tail := []
    while len(parts) > 0 {
        last := parts[len(parts) - 1]; parts = slice(parts, 0, len(parts) - 1)
        if last != "" && last != "." { tail = concat([last], tail) }
        parent := join(parts, "/")
        if parent == "" { if starts_with(normalized, "/") { parent = "/" } else { parent = "." } }
        if file_exists(parent) { return replace_str(join_path(path_absolute(parent), join(tail, "/")), "\\", "/") }
    }
    return ""
}

export func protected_output(state, output) {
    problem := validate_path_components(output); if problem != "" { return problem }
    problem = validate_state_path(state); if problem != "" { return problem }
    root := canonical_destination(state); target := canonical_destination(output)
    // Conservative folding also closes aliases on case-insensitive volumes.
    root = lower(root); target = lower(target)
    prefix := root; if !ends_with(prefix, "/") { prefix = prefix + "/" }
    if target == root || starts_with(target, prefix) { return "exports cannot write within the active state directory" }
    return ""
}
