from src.common import get, has
export func record_type(command) { if has(["render","convert","resize","thumbnail"],command){return "transform"}; return command }
export func id_prefix(command) { if has(["render","convert","resize","thumbnail"],command){return "transform"}; if command=="captions"{return "caption"}; return command }
func required(payload, fields) { for field in fields { if type(get(payload,field,null))=="null" || get(payload,field,"")=="" { return field+" is required" } }; return "" }
export func validate_command(command,payload,artifact) {
    if command=="plan" { return required(payload,["source_id","operation","output_name"]) }
    if command=="manifest" { e:=required(payload,["asset_id","media_type","rights_reference","accessibility_status"]); if e!=""{return e}; if type(artifact)!="dict"{return "manifest requires --path"}; return "" }
    if has(["captions","transcript"],command) { e:=required(payload,["asset_id","language","format"]); if e!=""{return e}; if type(artifact)!="dict"{return command+" requires --path"}; if command=="captions" && !has(["vtt","srt","text"],payload["format"]){return "unsupported caption format"}; return "" }
    if has(["render","convert","resize","thumbnail"],command) { e:=required(payload,["source_id","operation","adapter"]); if e!=""{if has_key(payload,"adapter")==0{return "unsupported: media transforms require an explicit adapter"}; return e}; return "" }
    return ""
}
