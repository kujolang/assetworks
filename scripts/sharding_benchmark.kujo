// The shell wrapper runs phases as sibling processes so fixture preparation
// cannot inflate the migration/inspection peak RSS receipts.
from src.filesystem import confined_path, directory_page, page_cursor
from src.migration import migrate_state
arguments := args()
if len(arguments)!=3 { throw("use scripts/sharding_benchmark.sh COUNT") }
mode := arguments[0]; root := arguments[1]; count := to_int(arguments[2])
if count<100001 || count>1000000 { throw("count must be 100001..1000000") }
source := root+"/flat"; target := root+"/sharded"
if mode=="prepare" {
    if file_exists(source) || file_exists(target) { throw("benchmark requires new fixture directories") }
    create_dir(source+"/records")
    write_file(source+"/metadata.json",to_json({"schema_version":"1.0.0","tool":"assetworks","contract_version":"1.0.0"}),false)
    for index in range(0,count) { write_file(source+"/records/plan-"+to_string(1000000+index)+".json",to_string(index),false) }
    print(to_json({"phase":"prepare","entries":count,"verified":true})); exit(0)
}
if mode=="migrate" {
    if directory_page(source+"/records","",1000)["ok"] { throw("legacy scan ceiling must still apply") }
    start := current_timestamp(); migrated := migrate_state(source,target); elapsed := current_timestamp()-start
    if !migrated["ok"] { eprint(to_json(migrated)); throw("migration failed") }
    if migrated["value"]["files"]!=count { throw("migration count mismatch") }
    usage := process_usage()
    print(to_json({"verified":true,"phase":"migrate","entries":count,"migration_ms":elapsed,"peak_rss_bytes":usage["peak_rss_bytes"],"cpu_seconds":usage["cpu_seconds"],"scope":"synthetic storage fixture; domain validation is separate"})); exit(0)
}
if mode!="inspect" { throw("unknown benchmark phase") }
start := current_timestamp(); first := directory_page(target+"/records","",1000); first_ms := current_timestamp()-start
if !first["ok"] || len(first["names"])==0 || first["scanned"]>=count { throw("sharded first page must avoid scanning the whole collection") }
mut after := ""; mut done := false; mut observed := 0; mut pages := 0
locator := confined_path(target+"/records")
start = current_timestamp()
while !done {
    page := directory_page(target+"/records",after,1000)
    if !page["ok"] { throw(page["error"]) }
    for name in page["names"] {
        expected := to_string(to_int(substring(name,5,len(name)-5))-1000000)
        if read_file_beneath(locator["root"],locator["relative"]+"/"+page["shard"]+"/"+name,32)!=expected { throw("migrated byte drift") }
        observed = observed+1
    }
    pages = pages+1; done = !page["truncated"]
    if !done { next := page_cursor(page,page["names"][len(page["names"])-1]); if next==after { throw("cursor stuck") }; after=next }
}
if observed!=count { throw("migration omitted or duplicated entries") }
usage := process_usage()
print(to_json({"verified":true,"phase":"inspect","entries":count,"first_page_ms":first_ms,"first_page_entries_scanned":first["scanned"],"verify_all_ms":current_timestamp()-start,"pages":pages,"peak_rss_bytes":usage["peak_rss_bytes"],"cpu_seconds":usage["cpu_seconds"],"scope":"raw directory pages and exact bytes, not domain parsing; scanned excludes fixed root layout checks"}))
