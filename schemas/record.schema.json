{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssetWorks record",
  "type": "object",
  "required": [
    "schema_version",
    "tool_version",
    "contract_version",
    "id",
    "record_type",
    "command",
    "actor",
    "created_at",
    "provenance",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "tool_version": {
      "enum": [
        "0.1.0",
        "0.2.0"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,127}$"
    },
    "record_type": {
      "enum": [
        "plan",
        "transform",
        "captions",
        "transcript",
        "manifest"
      ]
    },
    "command": {
      "enum": [
        "plan",
        "render",
        "convert",
        "resize",
        "captions",
        "transcript",
        "thumbnail",
        "manifest"
      ]
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "array"
    },
    "payload": {
      "type": "object"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "additionalProperties": true
}
