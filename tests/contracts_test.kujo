from tests.support import test_root, cleanup_tree
from src.core import dispatch
from src.args import parse_args
from src.common import bounded_int
from src.storage import save_new
from src.hardening import adapter_conformance, validate_probe, streaming_checksum, contention_result
mut passed := 0; mut failed := 0
func check(ok, label) { if ok { passed = passed + 1 } else { failed = failed + 1; eprint("FAIL: " + label) } }
func opts(values) { return parse_args(values, ["json", "force", "dry-run"]) }
root := test_root("assetworks-contracts")
config := root + "-config.json"
for invalid in [{"state": 3}, {"actor": []}, {"limit": "5"}, {"limit": true}, {"limit": 1001}] {
    write_file(config, to_json(invalid), true)
    result := dispatch("doctor", opts(["--config", config]))
    check(!result["ok"] && result["code"] == "invalid_config", "invalid config type fails cleanly")
}
check(!bounded_int("999999999999999999999999999999999999999", 100, 1, 1000)["ok"], "numeric overflow rejected without conversion")
check(!bounded_int(true, 100, 1, 1000)["ok"], "boolean is not integer")
check(len(opts(["--state="])["errors"]) > 0, "empty equals value is usage error")
check(!adapter_conformance({"provider_class":"ffmpeg","explicit_binary":true,"network_access":false,"capabilities":[{}]})["ok"], "capability entries require known strings")
check(!validate_probe({"duration_ms":1,"width":1,"height":1,"codecs":[{}]})["ok"], "codec entries require strings")
check(!contention_result({"platform":"macos","workers":"8","attempted":8,"stored":8})["ok"], "benchmark counts require integers")
check(!dispatch("not-a-command", opts(["--state", root, "--actor", "tester"]))["ok"] && !file_exists(root), "dispatch unknown command has no effects")
created := dispatch("plan", opts(["--state", root, "--input", "fixtures/core.json", "--actor", "tester", "--id", "plan-contract"]))
record := created["value"]["record"]; record["id"] = "plan-read-command"; record["command"] = "report"; record["record_type"] = "report"
check(save_new(root, record)["ok"] && !dispatch("validate", opts(["--state", root, "--id", record["id"]]))["ok"], "persisted read command is not a record")
record = created["value"]["record"]; record["id"] = "plan-invalid-artifact"; record["artifact"] = 2
check(save_new(root, record)["ok"] && !dispatch("validate", opts(["--state", root, "--id", record["id"]]))["ok"], "persisted artifact must be object")
for malformed in [{"bytes":-1,"sha256":repeat("a",64),"path":"missing"},{"bytes":1,"sha256":"bad","path":"missing"},{"bytes":1,"sha256":repeat("a",64),"path":"missing","maximum_bytes":"100"}] {
    record = created["value"]["record"]; record["id"] = "plan-malformed-" + to_string(passed); record["artifact"] = malformed
    check(save_new(root,record)["ok"] && !dispatch("validate",opts(["--state",root,"--id",record["id"]]))["ok"],"persisted artifact shape rejected")
}
record = created["value"]["record"]; record["id"] = "plan-bad-receipt"; record["execution_receipt"] = {"execution":"completed"}
check(save_new(root,record)["ok"] && !dispatch("validate",opts(["--state",root,"--id",record["id"]]))["ok"],"receipt on non-transform rejected")
record = created["value"]["record"]; record["id"] = "plan-bad-payload"; record["payload"] = []
check(save_new(root,record)["ok"] && !dispatch("validate",opts(["--state",root,"--id",record["id"]]))["ok"],"persisted payload requires an object")
record = created["value"]["record"]; record["id"] = "plan-unicode-oversize"; payload := record["payload"]; payload["padding"] = repeat("Ω",600000); record["payload"] = payload
oversized := save_new(root,record)
check(!oversized["ok"] && oversized["code"]=="record_too_large" && !file_exists(root+"/transactions/plan-unicode-oversize.json"),"UTF-8 byte size is enforced before transaction publication")
record = created["value"]["record"]; record["id"] = "plan-unicode-control"; payload = record["payload"]; payload["label"] = "Ω"; record["payload"] = payload
check(save_new(root,record)["ok"],"small UTF-8 record remains supported")
output := root+"-export.json"; exported := dispatch("export",opts(["--state",root,"--output",output]))
check(exported["ok"] && exported["value"]["bytes"]==file_size(output),"export receipt reports UTF-8 bytes rather than characters")
cleanup_tree(output)
schema := parse_json(read_file("schemas/record.schema.json"))
check(json_schema_validate(created["value"]["record"],schema)["valid"],"created record matches public schema")
record = created["value"]["record"]; record["actor"] = "bad\nactor"
check(!json_schema_validate(record,schema)["valid"],"public schema rejects control characters")
record = created["value"]["record"]; record["execution_receipt"] = {"execution":"completed"}
check(!json_schema_validate(record,schema)["valid"],"public schema requires completed receipt evidence")
cleanup_tree(root); delete_file(config)
print(to_string(passed) + " passed; " + to_string(failed) + " failed")
if failed > 0 { exit(1) }
