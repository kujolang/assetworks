from src.core import dispatch
from src.args import parse_args
options := args(); state := options[0]; receipts := options[1]
mut succeeded := 0; mut failed := 0
for name in list_dir(receipts) {
    result := parse_json(read_file(receipts + "/" + name))
    if result["ok"] { succeeded = succeeded + 1 }
    else {
        if result["error_code"] != "duplicate_id" && result["error_code"] != "recovery_required" && result["error_code"] != "history_conflict" { eprint(to_json(result)); exit(1) }
        failed = failed + 1
    }
}
if succeeded != 1 || failed != 31 { eprint("same-ID contention did not elect exactly one writer"); exit(1) }
validated := dispatch("validate", parse_args(["--state", state], []))
if !validated["ok"] || validated["value"]["checked"] != 1 || validated["value"]["history_checked"] != 1 { eprint(to_json(validated)); exit(1) }
print("AssetWorks same-ID contention passed: 1 winner, 31 rejected, 1 reconciled record/event pair")
