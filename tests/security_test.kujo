from tests.support import test_root, cleanup_tree, make_link
from src.core import dispatch
from src.args import parse_args
mut passed:=0;mut failed:=0
func check(ok,label){if ok{passed=passed+1}else{failed=failed+1;eprint("FAIL: "+label)}}
func opts(v){return parse_args(v,["json","dry-run","force"])}
root:=test_root("assetworks-security");artifact:=root+"-artifact";write_file(artifact,"safe",true)
check(!dispatch("init",opts(["--state",root+"/../escape"]))["ok"],"state traversal")
secret:=root+"-secret.json";write_file(secret,"{\"schema_version\":\"1.0.0\",\"artifact_kind\":\"article\",\"provider_token\":\"nope\"}",true)
check(!dispatch("plan",opts(["--state",root,"--input",secret,"--actor","producer"]))["ok"],"secret rejection")
check(!dispatch("plan",opts(["--state",root,"--input","fixtures/core.json","--actor","producer","--timestamp","2026-13-40T25:61:61Z"]))["ok"],"timestamp range validation")
check(!dispatch("show",opts(["--state",root,"--id","../escape"]))["ok"],"record traversal")
created:=dispatch("plan",opts(["--state",root,"--input","fixtures/core.json","--actor","producer","--id","plan-secure","--timestamp","2026-08-14T04:00:00Z"]));check(created["ok"],"secure create")
create_dir(root+"/locks/plan-locked.lock");check(!dispatch("plan",opts(["--state",root,"--input","fixtures/core.json","--actor","producer","--id","plan-locked","--timestamp","2026-08-14T04:00:01Z"]))["ok"],"lock conflict");os_rmdir(root+"/locks/plan-locked.lock")
delete_file(secret);delete_file(artifact)
foreign_state:=root+"-foreign";check(dispatch("init",opts(["--state",foreign_state]))["ok"],"foreign state baseline");write_file(foreign_state+"/metadata.json","{\"schema_version\":\"1.0.0\",\"tool\":\"other-tool\",\"contract_version\":\"1.0.0\"}",true);check(!dispatch("init",opts(["--state",foreign_state]))["ok"],"incompatible state rejected")
symlink_state:=root+"-symlink";outside_state:=root+"-outside";create_dir(symlink_state);create_dir(outside_state);linked:=make_link(outside_state,symlink_state+"/records",true);if linked.exitcode==0{check(!dispatch("init",opts(["--state",symlink_state]))["ok"],"managed directory symlink rejected")}
print(to_string(passed)+" passed; "+to_string(failed)+" failed");if failed>0{exit(1)}
