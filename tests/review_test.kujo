from src.core import dispatch
from src.args import parse_args
from src.common import valid_timestamp
from src.storage import initialize, save_new

mut passed := 0; mut failed := 0
func check(ok, label) { if ok { passed = passed + 1 } else { failed = failed + 1; eprint("FAIL: " + label) } }
func opts(values) { return parse_args(values, ["json", "dry-run", "force"]) }
root := path_absolute("/tmp") + "/assetworks-review-" + uuid_v4()
preview := dispatch("plan", opts(["--state", root, "--input", "fixtures/core.json", "--actor", "tester", "--dry-run"]))
check(preview["ok"] && preview["value"]["dry_run"], "dry run returns proposed record")
check(!file_exists(root), "dry run creates no state")
invalid := dispatch("plan", opts(["--state", root, "--input", "fixtures/core.json"]))
check(!invalid["ok"] && !file_exists(root), "invalid mutation creates no state")
check(len(opts(["--state"])["errors"]) == 1, "missing flag value rejected")
check(len(opts(["--state", "--json"])["errors"]) == 1, "flag cannot consume following flag")
for timestamp in ["2026-02-29T00:00:00Z", "1900-02-29T00:00:00Z", "2026-04-31T00:00:00Z"] { check(!valid_timestamp(timestamp), "reject impossible date " + timestamp) }
for timestamp in ["2024-02-29T00:00:00Z", "2000-02-29T00:00:00.123Z", "2026-12-31T23:59:59Z"] { check(valid_timestamp(timestamp), "accept valid date " + timestamp) }
check(dispatch("init", opts(["--state", root]))["ok"], "review state initialized")
created := dispatch("plan", opts(["--state", root, "--input", "fixtures/core.json", "--actor", "tester", "--id", "plan-template"]))
check(created["ok"], "template record created")
record := created["value"]["record"]
// Materialize the boundary efficiently; this test checks read coverage, not write throughput.
mut i := 0
while i < 1000 {
    record["id"] = "plan-page-" + to_string(1000 + i)
    write_file(root + "/records/" + record["id"] + ".json", to_json(record), true)
    i = i + 1
}
validation := dispatch("validate", opts(["--state", root]))
check(!validation["ok"] && validation["code"] == "validation_incomplete" && validation["value"]["truncated"], "truncated validation cannot claim success")
doctor := dispatch("doctor", opts(["--state", root]))
check(!doctor["ok"] && doctor["code"] == "inspection_incomplete" && doctor["value"]["truncated"], "truncated doctor cannot claim health")
check(dispatch("validate", opts(["--state", root, "--id", "plan-template"]))["ok"], "explicit validation reaches record beyond first page")
outside := root + "-outside"; create_dir(outside)
linked := spawn_process(["ln", "-s", outside, root + "-link"], {"timeout_ms": 5000, "max_output_bytes": 4096})
if linked.exitcode == 0 {
    unsafe := root + "-link/nested"
    check(!dispatch("init", opts(["--state", unsafe]))["ok"], "symlinked ancestor rejected")
    check(!file_exists(outside + "/nested"), "symlink rejection precedes directory creation")
    check(!dispatch("export", opts(["--state", root, "--limit", "1", "--output", root + "-link/export.json"]))["ok"], "export symlinked ancestor rejected")
    check(!file_exists(outside + "/export.json"), "export does not write through symlink")
    delete_file(root + "-link")
}
for name in list_dir(root + "/records") { delete_file(root + "/records/" + name) }
for name in list_dir(root + "/history") { delete_file(root + "/history/" + name) }
for name in ["records", "history", "locks"] { os_rmdir(root + "/" + name) }
delete_file(root + "/metadata.json"); os_rmdir(root); os_rmdir(outside)
print(to_string(passed) + " passed; " + to_string(failed) + " failed")
if failed > 0 { exit(1) }
