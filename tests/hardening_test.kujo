from src.hardening import adapter_conformance, streaming_checksum, validate_probe, sign_manifest, verify_manifest, contention_result
mut pass:=0;mut fail:=0;func check(ok,label){if ok{pass=pass+1}else{fail=fail+1;eprint("FAIL: "+label)}}
check(adapter_conformance({"provider_class":"ffmpeg","explicit_binary":true,"network_access":false,"capabilities":["probe","transcode"]})["ok"],"ffmpeg conformance");check(adapter_conformance({"provider_class":"image-processing","explicit_binary":true,"network_access":false,"capabilities":["resize"]})["ok"],"image conformance")
path:="/tmp/assetworks-stream-"+uuid_v4();write_file(path,"streaming bytes",true);check(streaming_checksum(path,67108865)["sha256"]==sha256_file(path),"streaming checksum")
for fixture in ["fixtures/probes/video.json","fixtures/probes/image.json"]{check(validate_probe(parse_json(read_file(fixture)))["ok"],"probe "+fixture)}
manifest:={"asset_id":"asset-fixture","checksum":sha256_file(path)};signed:=sign_manifest(manifest,"fixture-key-123456");check(signed["ok"]&&verify_manifest(manifest,signed["signature"],"fixture-key-123456"),"signed manifest");check(!verify_manifest(manifest,signed["signature"],"different-key-1234"),"signature drift")
check(contention_result({"platform":"macos","workers":8,"attempted":64,"stored":64})["ok"],"contention receipt");delete_file(path)
print(to_string(pass)+" passed; "+to_string(fail)+" failed");if fail>0{exit(1)}
