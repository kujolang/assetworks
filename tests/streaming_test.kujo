from src.core import dispatch
from src.args import parse_args
from src.filesystem import confined_digest
from tests.support import test_root, cleanup_tree, make_link
mut passed := 0; mut failed := 0
func check(ok, label) { if ok { passed = passed + 1 } else { failed = failed + 1; eprint("FAIL: " + label) } }
func opts(values) { return parse_args(values, ["json", "force", "dry-run"]) }
root := test_root("digest"); create_dir(root)
source := root + "/source.bin"; write_file(source, "digest-boundary", true)
input := root + "/input.json"; write_file(input, to_json({"schema_version":"1.0.0","asset_id":"sample","media_type":"application/octet-stream","rights_reference":"CC0-1.0","accessibility_status":"described"}), true)
base := ["--state",root + "/state","--actor","tester","--input",input,"--path",source,"--id","manifest-stream"]
created := dispatch("manifest", opts(concat(base, ["--max-artifact-bytes","15"])))
check(created["ok"] && created["value"]["record"]["artifact"]["maximum_bytes"] == 15, "exact streaming limit retained")
check(dispatch("validate", opts(["--state",root + "/state"]))["ok"], "streamed manifest validates")
write_file(source, "digest-tampered", true)
check(!dispatch("validate", opts(["--state",root + "/state"]))["ok"], "same-size byte drift rejected")
for bound in ["0","4294967297","999999999999999999999999","13"] { check(!dispatch("manifest", opts(concat(base,["--max-artifact-bytes",bound,"--dry-run"])))["ok"], "invalid or undersized streaming bound " + bound) }
check(dispatch("manifest",opts(concat(base,["--max-artifact-bytes","13","--dry-run"])))["code"]=="artifact_too_large","oversize artifact preserves error contract")
write_file(source, "", true)
check(confined_digest(source,1)["sha256"] == sha256(""), "empty artifact hashes correctly")
link := root + "/alias"; linked := make_link(source,link,false)
check(linked.exitcode == 0, "created digest symlink fixture")
mut rejected := false
try { confined_digest(link,100) } except error { rejected = true }
check(rejected, "streaming rejects final symlink")
cleanup_tree(root)
print(to_string(passed) + " passed; " + to_string(failed) + " failed")
if failed > 0 { exit(1) }
