from src.core import dispatch
from src.args import parse_args
from src.storage import recover_record
from tests.support import test_root, cleanup_tree
mut passed := 0; mut failed := 0
func check(ok, label) { if ok { passed = passed + 1 } else { failed = failed + 1; eprint("FAIL: " + label) } }
func opts(values) { return parse_args(values, ["json", "force", "dry-run"]) }
runtime := env("KUJO_BIN")
if type(runtime) != "string" || runtime == "" { eprint("recovery tests require KUJO_BIN"); exit(1) }
for phase in ["journal", "record", "event"] {
    root := test_root("recovery")
    killed := spawn_process([runtime, "run", path_absolute("tests/recovery_worker.kujo"), "--", root, phase], {"timeout_ms": 2000, "max_output_bytes": 4096})
    check(file_exists(root + "-ready") && killed.exitcode != 0, "writer terminated at " + phase)
    if phase != "event" { check(!dispatch("validate", opts(["--state", root]))["ok"] && !dispatch("doctor", opts(["--state", root]))["ok"], "pending transaction prevents healthy state " + phase) }
    recovered := dispatch("recover", opts(["--state", root, "--id", "plan-recovery"]))
    check(recovered["ok"], "recovery completes " + phase)
    check(dispatch("validate", opts(["--state", root]))["ok"], "recovered state reconciles " + phase)
    before := read_file(root + "/records/plan-recovery.json")
    check(recover_record(root, "plan-recovery")["ok"] && read_file(root + "/records/plan-recovery.json") == before, "recovery is idempotent " + phase)
    write_file(root + "/records/plan-recovery.json", "{\"tampered\":true}", true)
    conflict := recover_record(root, "plan-recovery")
    check(!conflict["ok"] && conflict["code"] == "recovery_conflict" && read_file(root + "/records/plan-recovery.json") == "{\"tampered\":true}", "recovery never overwrites divergent bytes " + phase)
    cleanup_tree(root); cleanup_tree(root + "-ready")
}
print(to_string(passed) + " passed; " + to_string(failed) + " failed")
if failed > 0 { exit(1) }
