from src.storage import initialize, save_with_checkpoints
options := args(); state := options[0]; stop_after := options[1]
func checkpoint(phase) {
    if phase == stop_after { write_file(state + "-ready", phase, true); while true { sleep(100) } }
}
initialize(state, {"schema_version":"1.0.0","tool":"assetworks","tool_version":"0.2.0","contract_version":"1.0.0","created_at":"2026-09-22T00:00:00Z"})
record := {"schema_version":"1.0.0","tool_version":"0.2.0","contract_version":"1.0.0","id":"plan-recovery","command":"plan","record_type":"plan","actor":"recovery-test","created_at":"2026-09-22T00:00:00Z","provenance":[],"payload":{"schema_version":"1.0.0","source_id":"source-test","operation":"probe","output_name":"result"}}
result := save_with_checkpoints(state, record, checkpoint)
print(to_json(result))
if !result["ok"] { exit(1) }
