from src.storage import list_records
from src.core import dispatch
from src.args import parse_args
from tests.support import test_root, cleanup_tree
mut passed := 0; mut failed := 0
func check(ok,label) { if ok { passed = passed + 1 } else { failed = failed + 1; eprint("FAIL: " + label) } }
root := test_root("pagination"); create_dir(root); create_dir(root + "/records")
for index in range(0,25) {
    id := "plan-" + to_string(1000+index)
    text := to_json({"id":id,"record_type":"plan","payload":{}})
    if index % 5 == 0 { text = "{" }
    write_file(root + "/records/" + id + ".json",text,true)
}
write_file(root + "/records/.json","{}",true)
mut cursor := ""; mut count := 0; mut warning_count := 0; mut pages := 0; mut more := true
while more {
    page := list_records(root,"",cursor,3)
    count = count + len(page["records"]); warning_count = warning_count + len(page["warnings"]); pages = pages + 1
    check(page["next_after"] != cursor,"cursor advances through malformed entries")
    cursor = page["next_after"]; more = page["truncated"]
    if pages > 20 { throw("pagination made no progress") }
}
check(count==20 && warning_count==6,"all valid and corrupt entries observed once")
filtered := list_records(root,"manifest","",3)
check(len(filtered["records"])==0 && filtered["truncated"] && filtered["next_after"]!="","empty filtered page remains resumable")
check(len(list_records(root,"","plan-1023",10)["records"])==1,"legacy record ID cursor accepted")
validation := dispatch("validate",parse_args(["--state",root,"--limit","3"],[]))
check(!validation["ok"] && validation["code"]=="validation_incomplete" && validation["value"]["scope"]=="page","partial validation cannot claim whole-state success")
resumed := dispatch("validate",parse_args(["--state",root,"--limit","3","--after",validation["value"]["next_after"],"--history-after",validation["value"]["next_history_after"],"--transaction-after",validation["value"]["next_transaction_after"]],[]))
check(!resumed["value"]["started_from_origin"] && resumed["value"]["next_after"]!=validation["value"]["next_after"],"all validation cursors can resume")
cleanup_tree(root)
root = test_root("pagination-prefix"); create_dir(root); create_dir(root+"/records")
for id in ["plan-a","plan-a-b"] { write_file(root+"/records/"+id+".json",to_json({"id":id,"record_type":"plan"}),true) }
first := list_records(root,"","",1)
check(first["records"][0]["id"]=="plan-a","prefix IDs sort by ID rather than filename suffix")
check(len(list_records(root,"","plan-a",1)["records"])==1,"legacy cursor retains a longer prefixed ID")
write_file(root+"/records/.json","{}",true)
empty_name := list_records(root,"","",1)
resumed_empty := list_records(root,"",empty_name["next_after"],1)
check(len(empty_name["warnings"])==1 && len(resumed_empty["records"])==1 && resumed_empty["next_after"]!=empty_name["next_after"],"single-entry page advances beyond empty JSON basename")
cleanup_tree(root)
root = test_root("pagination-bytes"); create_dir(root); create_dir(root + "/records")
padding := repeat("Ω",450000)
for index in range(0,12) { id := "plan-"+to_string(1000+index); write_file(root+"/records/"+id+".json",to_json({"id":id,"record_type":"plan","padding":padding}),true) }
bounded := list_records(root,"","",1000)
check(bounded["truncated"] && bounded["read_bytes"]<=8388608 && len(bounded["records"])<12,"aggregate record bytes bounded independently of page count")
check(len(list_records(root,"",bounded["next_after"],1000)["records"])+len(bounded["records"])==12,"byte-budget boundary resumes without loss")
cleanup_tree(root)
print(to_string(passed)+" passed; "+to_string(failed)+" failed")
if failed>0 { exit(1) }
