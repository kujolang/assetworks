from src.captions import convert_captions
from src.core import dispatch
from src.args import parse_args
from src.filesystem import confined_read
from tests.support import test_root, cleanup_tree
mut passed:=0; mut failed:=0
func check(ok,label) { if ok { passed=passed+1 } else { failed=failed+1; eprint("FAIL: "+label) } }
func opts(values) { return parse_args(values,["json","force","dry-run","resume"]) }
input:=replace_str(read_file("fixtures/media/captions.srt"),"\r\n","\n")
converted:=convert_captions(input,"srt","vtt")
check(starts_with(converted["text"],"WEBVTT\n\n00:00:00.000 --> 00:00:01.500"),"canonical VTT output")
check(convert_captions(converted["text"],"vtt","srt")["text"]==input,"exact canonical SRT round trip")
check(convert_captions(replace_str(input,"\n","\r\n"),"srt","vtt")["text"]==converted["text"],"Windows newlines normalize")
plain:=convert_captions(converted["text"],"vtt","text")
check(plain["text"]=="A blue square appears.\n\nSilence — no dialogue.\n" && plain["cues"]==2,"Unicode plain transcript extraction")
for bad in ["",replace_str(input,"00:00:01,500","00:00:00,000"),replace_str(input,"00:00:02,000","00:00:01,000"),replace_str(input,"A blue square appears.","<script>bad</script>"),replace_str(input,"00:00:03,000","00:70:03,000"),replace_str(input,"2\n","8\n"),replace_str(input," --> "," --> "+"\n"),input+repeat("x",1048576)] {
    rejected:=false; try { convert_captions(bad,"srt","vtt") } except error { rejected=true }
    check(rejected,"unsafe or unsupported caption rejected")
}
root:=test_root("captions"); create_dir(root)
payload:=root+"/input.json"; state:=root+"/state"
write_file(payload,to_json({"asset_id":"original","language":"en","format":"vtt","input_format":"srt"}),false)
flags:=["--state",state,"--input",payload,"--path",path_absolute("fixtures/media/captions.srt"),"--adapter-config","fixtures/caption-adapter.json","--actor","caption-test","--id","caption-converted"]
check(dispatch("captions",opts(concat(flags,["--dry-run"])))["ok"] && !file_exists(state),"dry-run validates without writing")
result:=dispatch("captions",opts(flags))
if !result["ok"] { eprint(to_json(result)) }
check(result["ok"],"caption adapter publishes record")
if result["ok"] {
    record:=result["value"]["record"]
    check(confined_read(record["artifact"]["path"],1048576)==converted["text"] && record["artifact"]["sha256"]==sha256(converted["text"]),"generated bytes and digest match")
    write_file(payload,to_json({"asset_id":"original","language":"en","format":"text","input_format":"vtt"}),true)
    transcript:=dispatch("transcript",opts(["--state",state,"--input",payload,"--path",record["artifact"]["path"],"--adapter-config","fixtures/caption-adapter.json","--actor","caption-test","--id","transcript-extracted"]))
    check(transcript["ok"],"transcript adapter executes")
    check(dispatch("validate",opts(["--state",state]))["ok"],"accessibility artifacts reconcile")
}
cleanup_tree(root)
print(to_string(passed)+" passed; "+to_string(failed)+" failed")
if failed>0 { exit(1) }
